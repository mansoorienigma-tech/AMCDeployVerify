# =============================================================================
# compat_2023_2.tcl
# -----------------------------------------------------------------------------
# Compatibility layer for running the MathWorks R2025b "Deep Learning design
# with I/Q DAC/ADC and real-time interfaces" reference design (generated for
# Vivado 2024.1) under Vivado 2023.2, in batch mode.
#
# It does four things:
#   1. Accepts Vivado 2023.2 instead of aborting on the hard version check.
#   2. Resolves IP VLNV versions against the *installed* IP catalog, so an IP
#      that is 3.5 in 2024.1 and 3.4 in 2023.2 is still found.
#   3. Applies CONFIG properties one by one when a whole -dict fails on an
#      older IP revision, and reports exactly which properties were skipped.
#   4. Never calls GUI/layout commands (regenerate_bd_layout, start_gui),
#      which is what crashed Vivado when the AI IP was inserted.
#
# This file is sourced by the patched Tcl scripts and by build_2023_2.tcl.
# =============================================================================

namespace eval ::mwcompat {
    variable loaded   1
    variable prefix   "MW-2023.2"
    variable search_dirs {}
}

proc mw_log {msg} {
    puts "$::mwcompat::prefix: $msg"
}

proc mw_add_search_dir {dir} {
    if {$dir eq ""} { return }
    if {![file isdirectory $dir]} { return }
    set d [file normalize $dir]
    if {[lsearch -exact $::mwcompat::search_dirs $d] < 0} {
        lappend ::mwcompat::search_dirs $d
    }
}

proc mw_add_search_dirs {dirs} {
    foreach d $dirs { mw_add_search_dir $d }
}

# Return the full path of a required support file, searching every plausible
# location. A clear error is raised instead of a silent GUI crash.
proc mw_required_file {name {preferred {}}} {
    if {[file exists $name]} { return [file normalize $name] }

    set dirs {}
    foreach d $preferred { lappend dirs $d }
    foreach d $::mwcompat::search_dirs { lappend dirs $d }
    if {[info exists ::mw_hdl_dir]}     { lappend dirs $::mw_hdl_dir }
    if {[info exists ::mw_script_dir]}  { lappend dirs $::mw_script_dir }
    lappend dirs [pwd]
    catch { lappend dirs [file dirname [file normalize [info script]]] }

    foreach d $dirs {
        if {$d eq ""} { continue }
        set f [file join $d $name]
        if {[file exists $f]} { return [file normalize $f] }
    }
    error "Required file <$name> was not found. Searched: $dirs . Copy the files generated by HDL Workflow Advisor step 4.1 (add_pl_ddr.tcl, add_rfdc_ip.tcl, constr.xdc, ipcore/tclutils/*.tcl) next to the block design Tcl, or pass -hdl_prj to build_2023_2.tcl."
}

# Find the directory that contains a given support file.
proc mw_find_dir_for_file {name {preferred {}}} {
    set dirs $preferred
    foreach d $::mwcompat::search_dirs { lappend dirs $d }
    lappend dirs [pwd]
    foreach d $dirs {
        if {$d eq ""} { continue }
        if {[file exists [file join $d $name]]} { return [file normalize $d] }
    }
    return ""
}

proc mw_source_required {name {preferred {}}} {
    set f [mw_required_file $name $preferred]
    mw_log "source $f"
    uplevel 1 [list source $f]
}

# ---------------------------------------------------------------------------
# Version handling
# ---------------------------------------------------------------------------
proc mw_check_version {} {
    set v [version -short]
    if {[string first "2023.2" $v] == -1} {
        mw_log "WARNING: this project is patched for Vivado 2023.2, current tool is $v"
    } else {
        mw_log "running on Vivado $v (batch mode)"
    }
    return $v
}

proc mw_version_key {v} {
    set key ""
    foreach p [split $v "."] {
        if {![string is integer -strict $p]} { set p 0 }
        append key [format "%05d" $p] "."
    }
    return $key
}

# ---------------------------------------------------------------------------
# IP catalog resolution
# ---------------------------------------------------------------------------
proc mw_resolve_ip_vlnv {vlnv} {
    set exact ""
    catch { set exact [get_ipdefs -quiet -all $vlnv] }
    if {[llength $exact] > 0} { return $vlnv }

    set f [split $vlnv ":"]
    if {[llength $f] < 4} { return "" }
    set pat "[lindex $f 0]:[lindex $f 1]:[lindex $f 2]:*"

    set cands {}
    catch { set cands [get_ipdefs -quiet -all $pat] }
    if {[llength $cands] == 0} {
        # Some Vivado releases do not accept a wildcard in get_ipdefs.
        catch {
            foreach d [get_ipdefs -quiet -all] {
                if {[string match $pat $d]} { lappend cands $d }
            }
        }
    }
    if {[llength $cands] == 0} { return "" }

    set best ""
    set bestkey ""
    foreach c $cands {
        set s [string trim $c]
        catch { set s [string trim [get_property VLNV $c]] }
        set cf [split $s ":"]
        if {[llength $cf] < 4} { continue }
        set k [mw_version_key [lindex $cf 3]]
        if {[string compare $k $bestkey] > 0} {
            set bestkey $k
            set best $s
        }
    }
    return $best
}

proc mw_ip_exists {vlnv} {
    if {[mw_resolve_ip_vlnv $vlnv] eq ""} { return 0 }
    return 1
}

proc mw_create_bd_ip {vlnv name} {
    set resolved [mw_resolve_ip_vlnv $vlnv]
    if {$resolved eq ""} {
        error "IP <$vlnv> is not in the Vivado [version -short] IP catalog. Add its repository with 'set_property ip_repo_paths ...' and 'update_ip_catalog -rebuild', then rerun."
    }
    if {$resolved ne $vlnv} {
        mw_log "IP version mapping for cell $name : $vlnv -> $resolved"
    }
    return [create_bd_cell -type ip -vlnv $resolved $name]
}

# ---------------------------------------------------------------------------
# CONFIG properties: try the original 'set_property -dict' first, then fall
# back to setting each property separately (older IP revisions).
# ---------------------------------------------------------------------------
proc mw_apply_ip_config {obj props} {
    if {![catch {set_property -dict $props $obj}]} { return }

    mw_log "set_property -dict failed on $obj; applying CONFIG properties individually."
    set skipped {}
    foreach {p v} $props {
        if {[catch {set_property $p $v $obj}]} { lappend skipped $p }
    }
    if {[llength $skipped] > 0} {
        mw_log "WARNING: [llength $skipped] CONFIG properties are not supported by this IP revision and were skipped on $obj:"
        mw_log "         $skipped"
        mw_log "         Check the Vivado log; if the design fails validation, these properties must be adapted."
    }
}

# ---------------------------------------------------------------------------
# GUI / layout commands: never run them in batch mode.
# ---------------------------------------------------------------------------
proc mw_regenerate_layout {} {
    if {[info exists ::env(MW_REGENERATE_BD_LAYOUT)] && $::env(MW_REGENERATE_BD_LAYOUT) eq "1"} {
        if {[catch {regenerate_bd_layout} e]} {
            mw_log "WARNING: regenerate_bd_layout failed: $e"
        }
    } else {
        mw_log "skipping regenerate_bd_layout (GUI layout command; set MW_REGENERATE_BD_LAYOUT=1 to force it)."
    }
}

proc mw_ignore_gui {{why {}}} {
    mw_log "ignored GUI command in batch mode ($why)"
}

# Bounded recursive file search (used to locate the generated HDL wrapper).
proc mw_find_file_recursive {root pattern {maxdepth 5}} {
    set found {}
    if {![file isdirectory $root]} { return $found }
    foreach f [glob -nocomplain -directory $root $pattern] { lappend found $f }
    if {$maxdepth <= 0} { return $found }
    foreach d [glob -nocomplain -directory $root *] {
        if {[file isdirectory $d]} {
            foreach f [mw_find_file_recursive $d $pattern [expr {$maxdepth - 1}]] {
                lappend found $f
            }
        }
    }
    return $found
}
