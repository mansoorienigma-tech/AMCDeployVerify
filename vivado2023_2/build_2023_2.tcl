# =============================================================================
# build_2023_2.tcl  --  Vivado 2023.2 batch entry point
# -----------------------------------------------------------------------------
# Rebuilds the complete RFSoC block design (subsystem IPs + the AI / deep
# learning processor IP) from the patched MathWorks Tcl scripts, then runs
# synthesis, implementation and write_bitstream -- all with "-mode batch",
# so no GUI is opened and the "graphics" crash cannot happen.
#
# Run with:
#   vivado -mode batch -source build_2023_2.tcl -tclargs \
#       -hdl_prj <hdl_prj> -dlip_name <IP name> -dlip_dir <IP folder> \
#       -bitstream -clean
#
# Options (or environment variables of the same meaning):
#   -hdl_prj      MW_HDL_PRJ      folder created by HDL Workflow Advisor step 4.1
#   -dlip_name    MW_DLIP_NAME    "IP core name" from testbench_ip_core_report.html
#   -dlip_dir     MW_DLIP_DIR     "IP core folder" from the same report
#   -dlip_vendor                 default mathworks.com
#   -project_dir                 where the fresh Vivado project is created
#   -jobs                        number of synthesis/implementation jobs
#   -clean                       delete the previous batch project first
#   -no-bitstream                only build/validate the block design
# =============================================================================

source [file join [file dirname [file normalize [info script]]] "compat_2023_2.tcl"]
mw_check_version

set kit [file dirname [file normalize [info script]]]

# ---------------------------------------------------------------------------
# Command line / environment
# ---------------------------------------------------------------------------
set hdl_prj     ""
set dlip_name   "dlprocessor"
set dlip_dir    ""
set dlip_vendor "mathworks.com"
set project_dir ""
set jobs        4
set do_bitstream 1
set do_clean     0

set i 0
while {$i < [llength $argv]} {
    set a [lindex $argv $i]
    switch -- $a {
        -hdl_prj      { set hdl_prj      [lindex $argv [incr i]] }
        -dlip_name    { set dlip_name    [lindex $argv [incr i]] }
        -dlip_dir     { set dlip_dir     [lindex $argv [incr i]] }
        -dlip_vendor  { set dlip_vendor  [lindex $argv [incr i]] }
        -project_dir  { set project_dir  [lindex $argv [incr i]] }
        -jobs         { set jobs         [lindex $argv [incr i]] }
        -clean        { set do_clean     1 }
        -bitstream    { set do_bitstream 1 }
        -no-bitstream { set do_bitstream 0 }
        default       { mw_log "ignoring unknown option: $a" }
    }
    incr i
}

if {$hdl_prj eq ""   && [info exists ::env(MW_HDL_PRJ)]}    { set hdl_prj   $::env(MW_HDL_PRJ) }
if {$dlip_name eq "" && [info exists ::env(MW_DLIP_NAME)]}  { set dlip_name $::env(MW_DLIP_NAME) }
if {$dlip_dir eq ""  && [info exists ::env(MW_DLIP_DIR)]}   { set dlip_dir  $::env(MW_DLIP_DIR) }

if {$hdl_prj eq ""} {
    error "MW-2023.2: -hdl_prj (or MW_HDL_PRJ) is required. Point it at the hdl_prj folder generated by HDL Workflow Advisor step 4.1."
}
set hdl_prj [file normalize $hdl_prj]
if {![file isdirectory $hdl_prj]} {
    error "MW-2023.2: hdl_prj folder does not exist: $hdl_prj"
}

set vivado_ip_prj [file join $hdl_prj "vivado_ip_prj"]
set cands [list \
    $hdl_prj \
    $vivado_ip_prj \
    [file join $vivado_ip_prj "ipcore"] \
    [file join $vivado_ip_prj "ipcore" "tclutils"] \
    [file join $hdl_prj "ipcore"] \
    [file join $hdl_prj "ipcore" "tclutils"] \
    $kit]
mw_add_search_dirs $cands

# ---------------------------------------------------------------------------
# Locate the MathWorks support Tcl files produced by step 4.1
# ---------------------------------------------------------------------------
set mw_hdl_dir [mw_find_dir_for_file "add_DLIP.tcl" $cands]
if {$mw_hdl_dir eq ""} { set mw_hdl_dir [mw_find_dir_for_file "mw_compile_dma.tcl" $cands] }
if {$mw_hdl_dir eq ""} {
    error "MW-2023.2: add_DLIP.tcl / mw_compile_dma.tcl not found under $hdl_prj . Run HDL Workflow Advisor steps 1.1-4.2 first so the reference design Tcl files are generated."
}
set mw_script_dir [mw_find_dir_for_file "add_system.tcl" $cands]
if {$mw_script_dir eq ""} { set mw_script_dir $vivado_ip_prj }
mw_add_search_dirs [list $mw_hdl_dir $mw_script_dir $kit]
mw_log "support Tcl folder : $mw_hdl_dir"
mw_log "block design folder: $mw_script_dir"

# ---------------------------------------------------------------------------
# Fresh Vivado project (never reuse a half-built GUI project)
# ---------------------------------------------------------------------------
if {$project_dir eq ""} { set project_dir [file join $vivado_ip_prj "vivado_2023_2_prj"] }
set project_dir [file normalize $project_dir]

if {$do_clean && [file isdirectory $project_dir]} {
    catch { close_project }
    mw_log "removing previous batch project $project_dir"
    file delete -force $project_dir
}
file mkdir $project_dir
set xpr [file join $project_dir "vivado_2023_2_prj.xpr"]

if {[file exists $xpr]} {
    open_project $xpr
    if {[llength [get_files -quiet *.bd]] > 0} {
        error "MW-2023.2: $xpr already contains a block design. Rerun with -clean (or delete $project_dir) so the design is rebuilt from the patched Tcl."
    }
} else {
    create_project vivado_2023_2_prj $project_dir -part xczu28dr-ffvg1517-2-e
    if {[catch {set_property board_part xilinx.com:zcu111:part0:1.1 [current_project]} e]} {
        mw_log "WARNING: could not set the ZCU111 board part: $e"
    }
}
mw_add_search_dir $project_dir

# ---------------------------------------------------------------------------
# IP repositories (custom MathWorks/ADI/DL IPs)
# ---------------------------------------------------------------------------
set repos {}
if {$dlip_dir ne "" && [file isdirectory $dlip_dir]} {
    lappend repos [file normalize $dlip_dir]
} else {
    mw_log "WARNING: -dlip_dir is empty; the AI IP must already be in the project's IP repositories."
}
foreach d [list \
        [file join $vivado_ip_prj "ipcore"] \
        [file join $hdl_prj "ipcore"] \
        [file join $vivado_ip_prj "ipcore" "tclutils"]] {
    if {[file isdirectory $d]} { lappend repos [file normalize $d] }
    foreach c [glob -nocomplain -directory $d *] {
        if {[file exists [file join $c "component.xml"]]} { lappend repos [file normalize $c] }
    }
}

set existing {}
catch { set existing [get_property ip_repo_paths [current_project]] }
set all_repos $existing
foreach r $repos {
    if {[lsearch -exact $all_repos $r] < 0} { lappend all_repos $r }
}
if {[llength $all_repos] > 0} {
    set_property ip_repo_paths $all_repos [current_project]
    mw_log "IP repositories: $all_repos"
    update_ip_catalog -rebuild
}

# ---------------------------------------------------------------------------
# Reference design parameters for the AI IP (step 1.2 of the advisor)
# ---------------------------------------------------------------------------
set DLIPcoreName     $dlip_name
set DLIPcoreFolder   $dlip_dir
set DLIPcoreVendor   $dlip_vendor
set DLIPcoreLocation $dlip_dir
set ::env(MW_DLIP_NAME) $dlip_name
mw_log "DL IP: name=$DLIPcoreName vendor=$DLIPcoreVendor folder=$DLIPcoreFolder"

# ---------------------------------------------------------------------------
# Build the block design from the patched Tcl
# ---------------------------------------------------------------------------
set add_sys ""
catch { set add_sys [mw_required_file "add_system_2023_2.tcl" [list $kit]] }
if {$add_sys eq ""} { set add_sys [mw_required_file "add_system.tcl" [list $vivado_ip_prj $kit]] }

mw_log "building block design from $add_sys"
if {[catch {source $add_sys} e]} {
    error "MW-2023.2: block design build failed: $e . Read vivado_2023_2.log for the first MW-2023.2 / ERROR line."
}

save_bd_design
set design_name_used "system"
if {[info exists design_name]} { set design_name_used $design_name }
set bd [get_files -quiet "${design_name_used}.bd"]
if {[llength $bd] == 0} {
    error "MW-2023.2: ${design_name_used}.bd was not created. See the log above."
}
mw_log "block design ${design_name_used}.bd is ready."

if {!$do_bitstream} {
    mw_log "-no-bitstream was given: stopping after the block design."
    return
}

# ---------------------------------------------------------------------------
# Wrapper + bitstream, still in batch mode
# ---------------------------------------------------------------------------
if {[catch {generate_target all $bd} e]} { mw_log "WARNING: generate_target: $e" }
make_wrapper -files $bd -top

set wrapper ""
foreach c [glob -nocomplain [file join [file dirname $bd] "hdl" "${design_name_used}_wrapper.v"]] {
    set wrapper $c
    break
}
if {$wrapper eq ""} {
    foreach c [mw_find_file_recursive $project_dir "${design_name_used}_wrapper.v"] {
        set wrapper $c
        break
    }
}
if {$wrapper eq ""} {
    error "MW-2023.2: ${design_name_used}_wrapper.v was not produced by make_wrapper."
}
add_files -norecurse $wrapper
update_compile_order -fileset sources_1
set_property top ${design_name_used}_wrapper [current_fileset]

mw_log "launching synthesis ($jobs jobs) ..."
launch_runs synth_1 -jobs $jobs
wait_on_run synth_1
if {[get_property STATUS [get_runs synth_1]] ne "synth_design Complete!"} {
    mw_log "WARNING: synth_1 status = [get_property STATUS [get_runs synth_1]]"
}

mw_log "launching implementation / write_bitstream ($jobs jobs) ..."
launch_runs impl_1 -to_step write_bitstream -jobs $jobs
wait_on_run impl_1
mw_log "impl_1 status = [get_property STATUS [get_runs impl_1]]"

foreach b [glob -nocomplain [file join $project_dir "vivado_2023_2_prj.runs" "impl_1" "*.bit"]] {
    mw_log "BITSTREAM: $b"
}
mw_log "Done. Copy system_wrapper.bit to the MATLAB working folder and continue with socUpdateBitstreamBuildInfo('system_wrapper.bit') and programFPGA(...)."
